function usage
{
	cat << EOF
Usage: $(basename $0) [options] <output directory>

Wrapper script to generate reconstructed gene trees from "true" gene trees by
chaining rose, mafft, raxml. Reads trees from standard input (phylip format, one
per line), outputs everything to <output directory>.

Options:
  -s, --seed <s>         random seed for rose (<s>=int in [1:Inf), default=1000)
  -g, --gamma-seed <s>   random seed for gamma generator (<s>=int in [1:Inf),
                         default=1000)
  -b, --boot-seed <s>    random seed for RAxML bootstrapping (<s>=int in
                         [1:Inf), default=1000)
  -l, --seq-len <l>      sequence lenght (<l>=int in [1:Inf), default=1000)
  -y, --PAM-type <type>  PAM matrix type (<type>=string matching regex
                         /nematode|sate/, default=sate)
  -t, --PAM-time <t>     PAM matrix time (<t>=float in (0.0:Inf), default=0.001)
  -d, --gap-dist <l>     Gap length distribution (<l>=string matching regex
                         /long|medium|short/, default=short)
  -i, --insdel-prob <p>  Insertion/deletion probability (<p>=float in [0.0:Inf),
                         default=0.0000043)
  -o, --boot-num <N>     Number of replicae for RAxML bootstrapping (<N>=int in
                         [1:Inf), default=100)
  -c, --disc-dist        discard distances in trees
  --log-file <file>      log file (<file>=string, default=/dev/stderr)
  --version              output version information and exit
  --help                 print this help and exit
EOF
}

function usage_brief
{
	cat << EOF
Usage: $(basename $0) [options] <output directory>
(Use $(basename $0) --help for more information.)
EOF
}

function print_version
{
	cat << EOF
Version information unspecified
EOF
}

default_seed="1000"
default_gamma_seed="1000"
default_boot_seed="1000"
default_seq_len="1000"
default_PAM_type="sate"
default_PAM_time="0.001"
default_gap_dist="short"
default_insdel_prob="0.0000043"
default_boot_num="100"
default_disc_dist="false"
default_log_file="/dev/stderr"
function err_mess { echo "$(basename $0): error: $1" >> /dev/stderr; }
function abort { local outval="$2"; err_mess "$1"; [[ -n "$outval" ]] || outval=2; exit $outval; }

function init_options { for opt in "$@"; do set_option_from_default "$opt"; done; }
function set_option_from_default { eval "$1=\"\$default_$1\""; }

function check_is_empty { eval "[[ -z \"\$$1\" ]]"; }
function check_is_int { eval "[[ -n \"\$$1\" ]] && echo \"\$$1\" | egrep -q \"^[-+]?[[:digit:]]+\$\""; }
function check_is_float { eval "[[ -n \"\$$1\" ]] && echo \"\$$1\" | egrep -q \"^[-+]?([[:digit:]]+(\.[[:digit:]]*)?|\.[[:digit:]]+)([eE][-+]?[[:digit:]]+)?\$\""; }

function check_is_in_range
{
	eval "local x=\$$1"
	local openlow="$2"
	local lower="$3"
	local step="$4"
	local upper="$5"
	local openup="$6"
	local ol=0 ou=0
	[[ "$openlow" == "(" ]] && ol=1
	[[ "$openup" == ")" ]] && ou=1
	[[ "$lower" != "-Inf" ]] && [[ "$(echo "$x" | gawk -v l=$lower -v o=$ol '($1 < l || ($1 == l && o == 1)) {print 1}')" == 1 ]] && return 1
	[[ "$upper" != "Inf" ]] && [[ "$(echo "$x" | gawk -v u=$upper -v o=$ou '($1 > u || ($1 == u && o == 1)) {print 1}')" == 1 ]] && return 1
	if [[ "$step" != "0" ]]
	then
		if echo "$x" | gawk -v l=$lower -v u=$upper -v s=$step \
			'{
				if (s > 0) {
					d = ($1 - l)
				} else {
					d = (u - $1);
					s = -s
				}
				r = d % (s * (1 - 1e-15))
				if (r < 0) { r = -r }
				if (r > d * 5e-15) {
					exit 0
				} else {
					exit 1
				}
			}'
		then
			return 1
		fi
	fi
	return 0
}

function bop_pygrep
{
	/usr/bin/python -c "
import re
import sys

regex = re.compile(sys.argv[1])
line = sys.argv[2]

if re.search(regex, line) != None:
	sys.exit(0)
else:
	sys.exit(1)
" "$1" "$2"
}

init_options \
	seed \
	gamma_seed \
	boot_seed \
	seq_len \
	PAM_type \
	PAM_time \
	gap_dist \
	insdel_prob \
	boot_num \
	disc_dist \
	log_file

PARAMETERS=$(getopt -o "s:g:b:l:y:t:d:i:o:c" -l "version, help, seed:, gamma-seed:, boot-seed:, seq-len:, PAM-type:, PAM-time:, gap-dist:, insdel-prob:, boot-num:, disc-dist, log-file:" -- "$@")

[ $? -ne 0 ] && { usage_brief; exit 1; }

eval set -- "$PARAMETERS"

while true
do
	case "$1" in
		-s|--seed)
			seed="$2"
			shift 2
			;;
		-g|--gamma-seed)
			gamma_seed="$2"
			shift 2
			;;
		-b|--boot-seed)
			boot_seed="$2"
			shift 2
			;;
		-l|--seq-len)
			seq_len="$2"
			shift 2
			;;
		-y|--PAM-type)
			PAM_type="$2"
			shift 2
			;;
		-t|--PAM-time)
			PAM_time="$2"
			shift 2
			;;
		-d|--gap-dist)
			gap_dist="$2"
			shift 2
			;;
		-i|--insdel-prob)
			insdel_prob="$2"
			shift 2
			;;
		-o|--boot-num)
			boot_num="$2"
			shift 2
			;;
		-c|--disc-dist)
			disc_dist="true"
			shift 1
			;;
		--log-file)
			log_file="$2"
			shift 2
			;;
		--)
			shift
			break
			;;
		--help)
			usage
			exit 0
			;;
		--version)
			print_version
			exit 0
			;;
		*)
			usage_brief
			exit 1
			;;
	esac
done

[[ -n "$1" ]] || { err_mess "argument missing: output directory"; usage_brief; exit 1; }
out_dir="$1"
shift

[[ -n "$1" ]] && { err_mess "extra arguments in the command line: $@"; usage_brief; exit 1; }

check_is_int seed || abort "Invalid argument to option seed (should be an INT): $seed"

check_is_in_range seed "[" 1 0 Inf ")" || abort "out of range argument to option seed: $seed (range is [1:Inf))"

check_is_int gamma_seed || abort "Invalid argument to option gamma-seed (should be an INT): $gamma_seed"

check_is_in_range gamma_seed "[" 1 0 Inf ")" || abort "out of range argument to option gamma-seed: $gamma_seed (range is [1:Inf))"

check_is_int boot_seed || abort "Invalid argument to option boot-seed (should be an INT): $boot_seed"

check_is_in_range boot_seed "[" 1 0 Inf ")" || abort "out of range argument to option boot-seed: $boot_seed (range is [1:Inf))"

check_is_int seq_len || abort "Invalid argument to option seq-len (should be an INT): $seq_len"

check_is_in_range seq_len "[" 1 0 Inf ")" || abort "out of range argument to option seq-len: $seq_len (range is [1:Inf))"

if ! bop_pygrep '^(nematode|sate)$' "$PAM_type"
then
	abort "Invalid argument to option PAM-type: $PAM_type (must match regex: /nematode|sate/)"
fi

check_is_float PAM_time || abort "Invalid argument to option PAM-time (should be a FLOAT): $PAM_time"

check_is_in_range PAM_time "(" 0.0 0 Inf ")" || abort "out of range argument to option PAM-time: $PAM_time (range is (0.0:Inf))"

if ! bop_pygrep '^(long|medium|short)$' "$gap_dist"
then
	abort "Invalid argument to option gap-dist: $gap_dist (must match regex: /long|medium|short/)"
fi

check_is_float insdel_prob || abort "Invalid argument to option insdel-prob (should be a FLOAT): $insdel_prob"

check_is_in_range insdel_prob "[" 0.0 0 Inf ")" || abort "out of range argument to option insdel-prob: $insdel_prob (range is [0.0:Inf))"

check_is_int boot_num || abort "Invalid argument to option boot-num (should be an INT): $boot_num"

check_is_in_range boot_num "[" 1 0 Inf ")" || abort "out of range argument to option boot-num: $boot_num (range is [1:Inf))"
